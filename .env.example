# Application
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
APP_KEY=
APP_NAME=librarian
LOG_LEVEL=info

# Authentication
LIBRARIAN_API_KEY=

# Anna's Archive
ANNA_ARCHIVE_URL=https://fr.annas-archive.gd/

# SMTP (for Kindle delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File handling
MAX_FILE_SIZE_MB=50
TEMP_DIR=/tmp/librarian
